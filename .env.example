# Copy to .env.local; never commit values.
# Realtime WebRTC transport and optional LiveKit Inference billing.
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Choose: livekit | openrouter | hybrid
# hybrid defaults to LiveKit STT + OpenRouter LLM + LiveKit TTS.
CONVERSATIONALIST_PRESET=livekit

# Optional independent stage overrides: livekit | openrouter.
# CONVERSATIONALIST_STT_PROVIDER=openrouter
# CONVERSATIONALIST_LLM_PROVIDER=openrouter
# CONVERSATIONALIST_TTS_PROVIDER=livekit

# Optional provider-qualified model IDs. If omitted, provider-specific defaults are used.
# LiveKit defaults: assemblyai/universal-3-6-pro, google/gemma-4-31b-it,
#   fishaudio/s2.1-pro, voice fa4c9eb3dccc4806b382b40d61c6b10a
# OpenRouter defaults: nvidia/parakeet-tdt-0.6b-v3, qwen/qwen3.5-9b,
#   qwen/qwen-audio-3.0-tts-flash, voice loongjohn (not Reachy's Aiden).
# CONVERSATIONALIST_STT_MODEL=
CONVERSATIONALIST_STT_LANGUAGE=en
# CONVERSATIONALIST_LLM_MODEL=
# CONVERSATIONALIST_TTS_MODEL=
# CONVERSATIONALIST_TTS_VOICE=
CONVERSATIONALIST_TTS_RESPONSE_FORMAT=mp3

# Required only when at least one stage selects OpenRouter.
# Provider credentials belong to the trusted Python worker, never web/.env.local.
OPENROUTER_API_KEY=

# Browser session issuance requires this separate local-development access token.
# Generate a long random value; NEVER embed it in client JS or the repo.
CONVERSATIONALIST_ACCESS_TOKEN=
