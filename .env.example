# Copy to .env.local; never commit values.
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# AI models: livekit | openrouter | hybrid
# Optional persona: default | 4g. 4g defaults to OpenRouter HeyGen/lucian;
# provide OPENROUTER_API_KEY. Explicit TTS settings override the defaults.
# Persona never grants tools.
CONVERSATIONALIST_PERSONALITY=default
CONVERSATIONALIST_PRESET=livekit
# CONVERSATIONALIST_STT_PROVIDER=openrouter
# CONVERSATIONALIST_LLM_PROVIDER=openrouter
# CONVERSATIONALIST_TTS_PROVIDER=livekit
# CONVERSATIONALIST_STT_MODEL=
CONVERSATIONALIST_STT_LANGUAGE=en
# CONVERSATIONALIST_LLM_MODEL=
# CONVERSATIONALIST_TTS_MODEL=
# CONVERSATIONALIST_TTS_VOICE=
# OpenRouter's default HeyGen Turbo voice uses PCM at 44.1 kHz. Other
# configured speech models may require a different format.
CONVERSATIONALIST_TTS_RESPONSE_FORMAT=pcm
OPENROUTER_API_KEY=
# Optional local detector: v1-mini runs locally; v1 uses LiveKit Inference.
# When omitted, LiveKit Agents selects its default version.
# CONVERSATIONALIST_TURN_DETECTOR_VERSION=v1-mini

# Optional MCP toolset; disabled when URL is absent. Requires explicit token
# and exact allowed tool names, preferably READ-ONLY initially. No wildcards.
# This client-side filter is NOT a replacement for server-side gateway grants.
# MCP_URL=http://127.0.0.1:4444/mcp
# MCP_TOKEN=dev-only-scoped-jwt
# MCP_ALLOWED_TOOLS=data_read,work_status

# Optional Forge Puppeteer restricted Reachy gateway. Only exact approved
# recorded moves are exposed as play_move. Configure this only with an
# operator-owned restricted_actions=true Puppeteer JSON file.
# PUPPETEER_MCP_CONFIG=/absolute/path/to/reachy-approved-moves.json
# PUPPETEER_MCP_COMMAND=/absolute/path/to/forge-puppeteer-mcp
# PUPPETEER_MCP_ALLOWED_TOOLS=play_move,list_assets,action_lookup,device_stop

# Optional one-room native Reachy+StackChan+SO-ARM Puppeteer ensemble.
# Only an operator-reviewed config with all native SDK safety gates may be used.
# Cannot run alongside PUPPETEER_MCP_CONFIG or PUPPETEER_EMBODIMENT_CONFIG.
# PUPPETEER_ENSEMBLE_CONFIG=/absolute/path/to/three-robots.json
# PUPPETEER_ENSEMBLE_COMMAND=/absolute/path/to/forge-puppeteer-ensemble
# Before enabling hardware, run the nonmoving preflight:
# python -m forge_conversationalist.ensemble_preflight --config /absolute/path/to/reviewed.json
# Both opt-in; default voice-only/semantic mode remains unchanged.
# CONVERSATIONALIST_PLAYBACK_PRESENCE=1
# CONVERSATIONALIST_OUTGOING_SPEECH_ENVELOPE=1
# Audio features do NOT imply speaker sync, grants, or physical STOP/sleep.

# Optional Hermes delegation; disabled unless explicitly enabled.
# IMPORTANT: Hermes may execute powerful tools. Use a constrained Hermes profile.
HERMES_DELEGATION_ENABLED=false
HERMES_API_URL=http://127.0.0.1:8642
# HERMES_API_KEY=separate-hermes-api-server-key

# Browser token gate (development only). Never expose provider secrets to web.
CONVERSATIONALIST_ACCESS_TOKEN=
