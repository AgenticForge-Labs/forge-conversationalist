# Copy to .env.local; never commit values.
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LiveKit Inference: no separate STT/LLM/TTS credentials.
CONVERSATIONALIST_STT_MODEL=assemblyai/universal-3-6-pro
CONVERSATIONALIST_STT_LANGUAGE=en
CONVERSATIONALIST_LLM_MODEL=google/gemma-4-31b-it
CONVERSATIONALIST_TTS_MODEL=fishaudio/s2.1-pro
CONVERSATIONALIST_TTS_VOICE=fa4c9eb3dccc4806b382b40d61c6b10a

# Browser session issuance requires this local-development access token.
# Generate a long random value; NEVER embed it in client JS or the repo.
CONVERSATIONALIST_ACCESS_TOKEN=
